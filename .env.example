# =============================================================================
# Docker WordPress + Nginx + MariaDB — Environment Configuration
# =============================================================================
# Copy this file to .env and customize:
#   cp .env.example .env
# =============================================================================

# ---- WordPress ----
# Official WordPress FPM image tag (e.g. 6.7-php8.3-fpm-alpine, 6.7-php7.4-fpm-alpine)
# See https://hub.docker.com/_/wordpress for available tags
WORDPRESS_TAG=6.7-php8.3-fpm-alpine
# Local directory to mount as WordPress document root
WORDPRESS_DIR=./www
# Database connection settings (must match MariaDB values below)
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_HOST=mariadb
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=password
# Database table prefix (useful for multi-site setups)
WORDPRESS_TABLE_PREFIX=wp_
# Enable WP_DEBUG mode (1 = on, 0 = off)
WORDPRESS_DEBUG=1

# ---- Nginx ----
# Ports to expose on the host
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ---- MariaDB ----
# Port to expose on the host (change if 3306 is already in use)
MARIADB_PORT=3306
# MariaDB root password
MYSQL_ROOT_PASSWORD=root_password

# ---- phpMyAdmin ----
# Port to expose on the host
PHPMYADMIN_PORT=8183
# Maximum upload size for phpMyAdmin imports
PHPMYADMIN_UPLOAD_LIMIT=128M
